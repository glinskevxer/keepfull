# Copy to .env on the yard machine. Nothing here has a sensible default that
# would be safe to ship, which is why the process refuses to boot without it.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

DATABASE_PATH=/var/lib/keepfull/keepfull.db
LOG_LEVEL=info
REQUEST_LOGGING=false

# The plant, which is where every route starts and ends.
YARD_LATITUDE=42.4432
YARD_LONGITUDE=-76.5019

DEFAULT_HORIZON_DAYS=120
DISPATCH_WINDOW_DAYS=5
TAX_PERCENT=0

# name:role:key, comma separated. Roles are office, driver, monitor, job, admin.
# Generate keys with: openssl rand -base64 32
API_KEYS=office:office:REPLACE_ME_WITH_A_REAL_KEY,handhelds:driver:REPLACE_ME_TOO
