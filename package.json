{
  "name": "keepfull",
  "version": "0.1.0",
  "private": true,
  "description": "Delivery forecasting and dispatch for a bulk propane dealer",
  "license": "UNLICENSED",
  "author": "glinskevxer <roym78109@gmail.com>",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "coverage": "vitest run --coverage",
    "check": "bash scripts/check.sh",
    "serve": "node dist/api/main.js",
    "cli": "tsx src/cli/main.ts",
    "export-check": "bash scripts/export-check.sh",
    "audit": "npm audit --omit=dev --json > audit.json || true && tsx scripts/audit-dependencies.ts --from-audit audit.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "20.17.19",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "prettier": "3.4.2",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "bin": {
    "keepfull": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
